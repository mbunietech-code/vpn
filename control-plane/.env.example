APP_NAME="Mbunie VPN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Local dev uses SQLite (WAMP MySQL service could not be started without
#     admin rights). Production control-plane VPS: switch DB_CONNECTION=mysql. ---

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email OTP — Hostinger SMTP for a noreply@mbuniehub.com mailbox
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@mbuniehub.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@mbuniehub.com"
MAIL_FROM_NAME="Mbunie VPN"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================ MVPN =====================================
# Node <-> control-plane shared secret is per-node (stored in DB, not here).

# --- Stripe (card + Alipay + WeChat Pay) ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Cryptomus (USDT / crypto) ---
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_KEY=
CRYPTOMUS_WEBHOOK_KEY=

# --- SMS OTP (optional; email OTP works without this). Twilio REST. ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Brevo (email API — recommended over SMTP on shared hosting) ---
BREVO_API_KEY=

# --- Dual-currency display ---
MVPN_CURRENCIES=usd,cny
MVPN_DEFAULT_CURRENCY=usd

# --- Provisioning ---
MVPN_PROVISION_TIMEOUT=60
MVPN_SUB_TOKEN_TTL_DAYS=0            # 0 = token lives as long as the subscription

# --- AI anomaly alerting (Claude API) ---
ANTHROPIC_API_KEY=
MVPN_ALERT_MODEL=claude-sonnet-5
MVPN_ALERT_TELEGRAM_BOT_TOKEN=
MVPN_ALERT_TELEGRAM_CHAT_ID=


# --- ClickPesa (Tanzania: M-Pesa/Tigo/Airtel/bank, charged in TZS) ---
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_MERCHANT_ID=
CLICKPESA_CHECKSUM_SECRET=
